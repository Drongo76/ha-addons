#!/usr/bin/with-contenv sh
set -eu

export PORT="${PORT:-8099}"

# Debug/Reloader AUS
export FLASK_ENV=production
export FLASK_DEBUG=0
export WERKZEUG_DEBUG_PIN=off

# KRITISCH: damit /app.py als Modul "app" importierbar ist
export PYTHONPATH="/"

echo "[web] starting gunicorn on :${PORT} (PYTHONPATH=/)"

exec gunicorn \
  --chdir / \
  --bind "0.0.0.0:${PORT}" \
  --workers 1 \
  --threads 8 \
  --access-logfile - \
  --error-logfile - \
  "app:app"
