#!/usr/bin/with-contenv sh
set -eu

export PORT="${PORT:-8099}"

# Debug/Reloader AUS
export FLASK_ENV=production
export FLASK_DEBUG=0
export WERKZEUG_DEBUG_PIN=off

echo "[web] starting gunicorn on :${PORT}"

# WICHTIG: Lade WSGI aus Datei /app.py (nicht als Modul "app")
exec gunicorn \
  --bind "0.0.0.0:${PORT}" \
  --workers 1 \
  --threads 8 \
  --access-logfile - \
  --error-logfile - \
  "app:app" \
  --chdir /
